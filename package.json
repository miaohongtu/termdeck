{
  "name": "termdeck",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal persistent terminal workspace manager for macOS",
  "author": "miaohongtu",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "VITE_DEV_SERVER_URL=http://localhost:5173 concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test src/layout.test.ts src/snap.test.ts src/resizeFrame.test.ts src/terminalBehavior.test.ts src/imeGuard.test.ts src/workspaceRenderPlan.test.ts",
    "icon": "bash scripts/generate-mac-icon.sh",
    "dist": "npm run icon && npm run build && electron-builder --mac --arm64",
    "dist:x64": "npm run icon && npm run build && electron-builder --mac --x64",
    "dist:all": "npm run icon && npm run build && electron-builder --mac --arm64 --x64",
    "postinstall": "electron-builder install-app-deps && node scripts/fix-node-pty-permissions.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0-beta34",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.miaohongtu.termdeck",
    "productName": "Termdeck",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Termdeck ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
